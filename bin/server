#!/usr/bin/env perl
# Dual-stack PSGI listener for the Dancer2 app. HTTP::Server::PSGI's default
# IO::Socket::INET rejects host "::" (Invalid argument).
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../local/lib/perl5";
use lib "$FindBin::Bin/../lib";
use IO::Socket::IP;
use HTTP::Server::PSGI;
use Plack::Util;

package CarolinaCodes::PSGI;
use parent 'HTTP::Server::PSGI';

sub _socket {
    my (%args) = @_;
    return IO::Socket::IP->new(
        LocalPort => $args{port},
        LocalHost => $args{host},
        Listen    => 16,
        ReuseAddr => 1,
        Proto     => 'tcp',
        ($args{host} eq '::' ? (V6Only => 0) : ()),
    );
}

sub setup_listener {
    my $self = shift;
    my $port = $self->{port};
    my $sock = _socket(host => CarolinaCodes::Dancer::listen_host(), port => $port);

    # IPv4-only stacks (rootless Docker) reject "::" with EINVAL. Fly has IPv6.
    $sock ||= _socket(host => '0.0.0.0', port => $port);
    $sock or die "listen :$port: $!";
    $self->{listen_sock} = $sock;
    warn "carolina-codes-dancer listening on :$port\n";
    return;
}

package main;
my $port = $ENV{PORT} // 4017;
my $app  = Plack::Util::load_psgi("$FindBin::Bin/../app.psgi");
CarolinaCodes::PSGI->new(host => '::', port => $port)->run($app);
